---
import Layout from "@/layouts/Layout.astro";
import PostHeader from "@/components/post/PostHeader.astro";
import PostFooter from "@/components/post/PostFooter.astro";
import HyacineOutlet from "@hyacine/plugin-astro/components/HyacineOutlet.astro";
import { currentLocale } from "@/i18n";
import themeConfig from "@/theme.config";

import "@/styles/post.css";
import "@/styles/spoiler.css";
import "katex/dist/katex-swap.min.css";
import { avatar } from "@/components/Images.astro";

import FriendsContent, { frontmatter } from "@/content/friends.mdx";

const {
  title,
  description,
  date: dateString,
  updated: updatedString,
  cover,
  license,
  showCopyright,
  showReward,
} = frontmatter;

const date = new Date(dateString);
const updated = updatedString ? new Date(updatedString) : date;

const author = themeConfig.sidebar?.author || "Author";
const siteName = themeConfig.siteName || "Site";

// 路由要求尾斜杠
const postPath = "/friends/";
const permalink = import.meta.env.SITE
  ? new URL(postPath, import.meta.env.SITE).toString()
  : postPath;
---

<Layout pageTitle={title} pageDescription={description} pageCover={cover}>
  <Fragment slot="head">
    <link rel="canonical" href={permalink} />
  </Fragment>

  <Fragment>
    <div class="article wrap">
      <article
        itemscope
        itemtype="http://schema.org/Article"
        class="post block"
        data-pagefind-body
        lang={currentLocale}
      >
        <link itemprop="mainEntityOfPage" href={permalink} />

        <span
          hidden
          itemprop="author"
          itemscope
          itemtype="http://schema.org/Person"
        >
          <meta itemprop="image" content={avatar.src} />
          <meta itemprop="name" content={author} />
          <meta itemprop="description" content={`${siteName}`} />
        </span>

        <span
          hidden
          itemprop="publisher"
          itemscope
          itemtype="http://schema.org/Organization"
        >
          <meta itemprop="name" content={siteName} />
        </span>

        <PostHeader title={title} date={date} updated={updated} />

        <div class="body md" itemprop="articleBody">
          <FriendsContent />
        </div>

        <PostFooter
          permalink={permalink}
          title={title}
          author={author}
          siteName={siteName}
          showCopyright={showCopyright}
          showReward={showReward}
          license={license}
        />
      </article>
    </div>

    <div id="comments" class="comment">
      <HyacineOutlet name="comment" />
    </div>
  </Fragment>
</Layout>
